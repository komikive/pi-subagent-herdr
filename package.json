{
	"name": "pi-subagent-herdr",
	"version": "0.1.0",
	"description": "Observable Pi subagents that run in Herdr tabs: delegate work, watch it live, and keep it running after the parent session exits.",
	"keywords": ["pi-package", "pi", "herdr", "subagent", "subagents", "agent-orchestration", "terminal"],
	"type": "module",
	"license": "MIT",
	"files": [
		"index.ts",
		"herdr.ts",
		"shared.ts",
		"subagent.ts",
		"skills",
		"NOTICE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/komikive/pi-subagent-herdr.git"
	},
	"homepage": "https://github.com/komikive/pi-subagent-herdr#readme",
	"bugs": {
		"url": "https://github.com/komikive/pi-subagent-herdr/issues"
	},
	"engines": {
		"node": ">=22.19"
	},
	"bin": {
		"subagent": "./subagent.ts"
	},
	"pi": {
		"extensions": ["./index.ts"]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node test/subscription.test.mjs && node test/extension.test.mjs"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@earendil-works/pi-tui": "1.2.0",
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	}
}
